{
  "$schema": "https://simai.io/schemas/federation/repository-recipe.schema.json",
  "schema_version": "2.0.0",
  "id": "docara.project",
  "version": "3.0.0",
  "kind": "structural_recipe",
  "owner": "docara",
  "title": "docara.project",
  "repository_family": "docara",
  "repository_kind": "project",
  "base_recipe": "generic.repository",
  "compatibility": {
    "allowed_bases": [
      "generic.repository"
    ],
    "allowed_overlays": [
      "docara.technology-overlay",
      "docs.technology-overlay",
      "tester.technology-overlay"
    ],
    "incompatible_recipes": [
      "graph.domain_atlas",
      "client.project",
      "bitrix.module",
      "bitrix.client_project",
      "larena.application",
      "larena.package",
      "sf4.project",
      "sf5.project",
      "orgportal.solution"
    ]
  },
  "capabilities": [
    {
      "id": "project_technology",
      "activation": "required"
    }
  ],
  "requires_capabilities": [

  ],
  "required_inputs": [
    {
      "name": "repository_name",
      "required": true,
      "type": "string"
    },
    {
      "name": "default_locale",
      "required": true,
      "type": "string"
    }
  ],
  "source_contract": {
    "entrypoints": [
      "skills/docara/SKILL.md",
      "skills/docara/references/architecture-and-project-model.md"
    ],
    "processes": [
      "skills/docara/references/content-locales-and-navigation.md",
      "skills/docara/references/settings-and-inheritance.md"
    ],
    "checks": [
      "skills/docara/references/build-preview-and-verification.md",
      "skills/docara/references/security-and-troubleshooting.md"
    ]
  },
  "file_manifest": [
    {
      "path": "docara.json",
      "ownership": "managed",
      "required": true,
      "materializer": "owner_generator_output"
    },
    {
      "path": "simai-framework.lock.json",
      "ownership": "managed",
      "required": true,
      "materializer": "owner_generator_output"
    },
    {
      "path": "content/{default_locale}/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "assets/",
      "ownership": "owner_template",
      "required": true,
      "materializer": "directory"
    },
    {
      "path": "redirects.json",
      "ownership": "managed",
      "required": true,
      "materializer": "owner_generator_output"
    },
    {
      "path": "smart/",
      "ownership": "user_owned",
      "required": false,
      "materializer": "directory"
    },
    {
      "path": "design/",
      "ownership": "user_owned",
      "required": false,
      "materializer": "directory"
    }
  ],
  "availability": {
    "policy": "local_skill_override",
    "default_state": "available",
    "disabled_state_behavior": "catalog_visible_unavailable"
  },
  "migrations": [
    {
      "id": "docara.project.v2-to-v3-standalone-compiler-model",
      "from": "2.0.0",
      "to": "3.0.0",
      "operation": "adopt_standalone_compiler_contract",
      "preserve_user_owned": true
    }
  ],
  "materialization": {
    "mode": "declarative_manifest",
    "generator_contract": "repository_factory.manifest.v1",
    "template_root": null,
    "template_files": [],
    "owner_generator": {
      "id": "docara.init",
      "type": "command",
      "argv": [
        "php",
        "vendor/bin/docara",
        "init",
        "{{target_path}}"
      ],
      "preconditions": [
        "empty_target",
        "composer_dependency:simai/docara"
      ],
      "produced_paths": [
        "docara.json",
        "redirects.json",
        "simai-framework.lock.json",
        "assets/",
        "content/{default_locale}/",
        "smart/",
        "design/"
      ],
      "validator_refs": [
        "skills/docara/references/architecture-and-project-model.md",
        "skills/docara/references/build-preview-and-verification.md"
      ]
    }
  },
  "validators": [
    {
      "id": "docara.source-check.1",
      "type": "owner_source",
      "ref": "skills/docara/references/architecture-and-project-model.md",
      "required": true
    }
  ]
}
